# Frontend environment for the AI chat panel.
# Copy this file to .env and fill in real values. .env is gitignored.
#
# The chat talks to any OpenAI-compatible /chat/completions endpoint. We keep
# the provider out of the code so the workshop can point at whatever is handy
# (a hosted open model, a local server, etc.). Default is an open model.
#
# NOTE: Vite exposes only vars prefixed with VITE_ to the browser. Any key you
# put here ships to the client, so use a throwaway/limited key for teaching.

VITE_LLM_BASE_URL=https://api.openai.com/v1
VITE_LLM_API_KEY=your-key-here
VITE_LLM_MODEL=gpt-4o-mini

# Part 4: base URL of the reports API (the FastAPI service). Safe to expose — it's just
# an address, not a secret. The frontend calls ${VITE_API_BASE_URL}/reports.
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# BACKEND-ONLY (Part 4). This does NOT belong in the frontend .env above — it must
# never be a VITE_ var, or the Postgres credentials would ship to the browser.
# Put it in api/.env (gitignored). Get the connection string from your Supabase project:
#   Project Settings → Database → Connection string (URI).
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
